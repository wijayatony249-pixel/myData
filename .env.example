# Konfigurasi Klaster myData
CLUSTER_TOKEN=mydata-token-uas-kpt-2026
MASTER_HOST=127.0.0.1
MASTER_PORT=8000
WORKER_PORT=9000

# Database: PostgreSQL untuk cluster riil (atau aiosqlite untuk dev/uji mandiri)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/mydata
DATABASE_URL=sqlite+aiosqlite:///./data/mydata.db

# Parameter Chunking dan Direktori
CHUNK_SIZE=200000
DATA_DIR=./data
CACHE_DIR=./data/cache

# Parameter Fault Tolerance
HEARTBEAT_INTERVAL_SEC=2
HEARTBEAT_TIMEOUT_SEC=6
LEASE_DURATION_SEC=30
MAX_TASK_ATTEMPTS=3

# Pengaturan Eksekusi Multiprocessing
WORKER_PROCESSES=0  # 0 = otomatis sesuai jumlah core fisik CPU
PYTHONUTF8=1
